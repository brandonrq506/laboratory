{
  "name": "laboratory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "postinstall": "npm run build",
    "serve-heroku": "npx serve -s dist -l $PORT",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,html}\"",
    "prettier:fix": "prettier --write \"src/**/*.{ts,tsx,html}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:expert": "DEBUG_PRINT_LIMIT=10000 npm run test",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "linters": "npm run prettier:fix && npm run lint:fix && npm run type-check && npm run test:run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^9.2.8",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "serve": "^14.2.5",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/devtools": "^4.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/ui": "^5.0.0",
    "baseline-browser-mapping": "^2.11.29",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "jsdom-testing-mocks": "^1.16.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  }
}
